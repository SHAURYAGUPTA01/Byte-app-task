{
  // Press F5 in VS Code to open the app in a browser. Pick a name from the
  // dropdown in the "Run and Debug" panel. (Needs Chrome or Edge installed.)
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open index.html in Chrome",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "name": "Open index.html in Edge",
      "type": "msedge",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    }
  ]
}
